{
  "description": "Auto-update check on session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/update-check/check.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
